# PayLoom Environment Configuration
# Copy this to .env and fill in your actual values

# ═══════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payloom
DB_USER=payloom_user
DB_PASSWORD=your_secure_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# ═══════════════════════════════════════════════════════
# Redis Cache
# ═══════════════════════════════════════════════════════
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════
# JWT Authentication
# ═══════════════════════════════════════════════════════
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_string_here
JWT_REFRESH_SECRET=your_refresh_token_secret_minimum_32_chars_here
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# ═══════════════════════════════════════════════════════
# M-Pesa Daraja API (STK Push - Kenya)
# ═══════════════════════════════════════════════════════
MPESA_CONSUMER_KEY=your_consumer_key_from_safaricom_developer_portal
MPESA_CONSUMER_SECRET=your_consumer_secret_from_safaricom_developer_portal
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd1a2c6f6d3
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa-callback

# ═══════════════════════════════════════════════════════
# M-Pesa B2C (Agent Payouts)
# ═══════════════════════════════════════════════════════
MPESA_B2C_SHORTCODE=600123
MPESA_B2C_SECRET=your_b2c_password_here

# ═══════════════════════════════════════════════════════
# Stripe (Card Payments)
# ═══════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_51234567890abcdef
STRIPE_PUBLIC_KEY=pk_test_51234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdef

# ═══════════════════════════════════════════════════════
# Flutterwave (Pan-Africa Payments)
# ═══════════════════════════════════════════════════════
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_your_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_your_public_key_here

# ═══════════════════════════════════════════════════════
# Firebase (Push Notifications)
# ═══════════════════════════════════════════════════════
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour_Firebase_Private_Key_Here\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ═══════════════════════════════════════════════════════
# Africa's Talking (SMS & Voice)
# ═══════════════════════════════════════════════════════
AFRICA_TALKING_API_KEY=your_africa_talking_api_key_here
AFRICA_TALKING_USERNAME=your_africa_talking_username
SMS_SENDER_ID=PayLoom

# ═══════════════════════════════════════════════════════
# AWS S3 (Alternative Image Storage)
# ═══════════════════════════════════════════════════════
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=payloom-instants-images

# ═══════════════════════════════════════════════════════
# Cloudinary (Recommended for Images)
# ═══════════════════════════════════════════════════════
CLOUDINARY_NAME=your_cloudinary_account_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ═══════════════════════════════════════════════════════
# Logging & Monitoring
# ═══════════════════════════════════════════════════════
LOG_LEVEL=info
DATADOG_API_KEY=your_datadog_api_key
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ═══════════════════════════════════════════════════════
# Rate Limiting
# ═══════════════════════════════════════════════════════
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ═══════════════════════════════════════════════════════
# Security & CORS
# ═══════════════════════════════════════════════════════
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
WEBHOOK_SECRET=your_webhook_signature_secret_key_here
CORS_CREDENTIALS=true

# ═══════════════════════════════════════════════════════
# Admin Configuration
# ═══════════════════════════════════════════════════════
ADMIN_EMAIL=admin@payloom.com
ADMIN_PHONE=254712345678

# ═══════════════════════════════════════════════════════
# Feature Flags
# ═══════════════════════════════════════════════════════
ENABLE_TEST_MODE=true
ENABLE_OFFLINE_MODE=false
ENABLE_MOCK_PAYMENTS=false
